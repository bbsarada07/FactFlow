# Inference: any OpenAI-compatible endpoint (Groq by default)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1/
NANO_MODEL=openai/gpt-oss-20b
ULTRA_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b

# Evidence sources (optional, but strongly recommended)
NEWS_API_KEY=your_newsapi_key_here
GOOGLE_FACT_CHECK_API_KEY=your_google_api_key_here

# Screenshots: Gemma 4 through the Gemini API reads the text (optional; without a key Tesseract is used)
GEMINI_API_KEY=
# Full path to tesseract.exe when it is not on PATH (optional)
TESSERACT_CMD=

# Database: falls back to local SQLite automatically if PostgreSQL is unreachable.
# Only ASYNC_DATABASE_URL is read by the backend; DATABASE_URL is kept for tools such as psql.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factflow
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/factflow

# Redis (only for the optional Celery queue, USE_CELERY=true; /health reports whether it answers)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
USE_CELERY=false

# App
SECRET_KEY=generate_a_random_64_char_string_here
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true

# Shield: email and message checks
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# OPERATOR_TOKEN unlocks approvals, policy changes, the audit log and the inbox list (left empty = those routes are closed).
OPERATOR_TOKEN=
# APPROVAL_SECRET signs approval tokens; at least 32 characters (left empty = no approvals are created).
APPROVAL_SECRET=
INBOX_USE_LLM=true
INBOX_MAX_CLAIMS=3
ENABLE_LINK_EXPANSION=false
ENABLE_DNS_CHECKS=false

# Read-only Gmail for the mail agent (see docs/GMAIL_SETUP.md). Use a throwaway test account only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mail/gmail/callback
# Encrypts stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
MAIL_POLL_ENABLED=true
MAIL_POLL_SECONDS=45
MAIL_FIRST_SYNC=20
MAIL_MAX_PER_SYNC=50
MAIL_AGENT_MAX_PER_MINUTE=20

# Pipeline
DEEP_REASONING_THRESHOLD=0.85
MAX_REQUESTS_PER_MINUTE=10

# Sandbox assistant demo (vulnerable baseline mode, default false)
ALLOW_VULNERABLE_DEMO=false

# WhatsApp checks (see docs/WHATSAPP_SETUP.md). Left empty = the webhook refuses requests; the app still starts.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_APP_SECRET=
PUBLIC_BASE_URL=
# Salts the SHA-256 of sender numbers (at least 16 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_HASH_SALT=
WHATSAPP_MAX_PER_HOUR=10

# Optional settings, left out on purpose: they have working defaults in config.py, and an empty line here
# would override the default. Uncomment and set one only if you need to change it.
#   VISION_PROVIDER                 gemini | groq | none
#   GEMMA_MODEL, GEMMA_MAX_IMAGE_BYTES
#   REASONING_PROVIDER              groq (the only allowed value)
#   NANO_REASONING_EFFORT, ULTRA_REASONING_EFFORT, LLM_TIMEOUT_SECONDS
#   GDELT_ENABLED, GDELT_URL, GDELT_ARCHIVE_START, NEWS_WINDOW_DAYS
#   TIER_1_DOMAINS, TIER_2_DOMAINS, TIER_4_DOMAINS (comma-separated source-tier allow-lists)
#   SQLITE_FALLBACK, BUILD_COMMIT, INFERENCE_PROVIDER
#   MAX_CLAIM_CHARS, MIN_STRONG_SOURCES, MIN_VERDICT_CONFIDENCE
#   REPEAT_WINDOW_DAYS, REPEAT_SIMILARITY, REPEAT_CORPUS_SIZE
#   OPERATOR_FAILURES_PER_MINUTE, INBOX_FACTCHECK_CONCURRENCY, INBOX_LLM_TIMEOUT_SECONDS, MAX_INBOX_PER_MINUTE
#   GOOGLE_SEARCH_URL, REVERSE_IMAGE_SEARCH_URL, PIB_FACTCHECK_URL
#   WHATSAPP_MAX_TEXT_CHARS, WHATSAPP_MAX_MEDIA_BYTES
# Tests only (never your real database; its tables are dropped): FACTFLOW_TEST_DATABASE_URL

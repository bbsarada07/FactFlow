# Where the FastAPI backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: public site URL for canonical and Open Graph links (falls back to the request host)
NEXT_PUBLIC_SITE_URL=
# Optional: backend URL used during server-side rendering, if it differs from NEXT_PUBLIC_API_URL
API_URL=

# Shield pages: false = use the real backend; true = MOCK data only, never for a demo
NEXT_PUBLIC_USE_MOCKS=false
